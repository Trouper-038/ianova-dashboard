```javascript name=assets/js/app.js
// assets/js/app.js
// Dashboard behavior and charts using Chart.js
// The script tries to fetch data/mock-data.json; if it fails, it falls back to inline mockData so the page works when opened locally.

(async function () {
  const defaultData = {
    stats: {
      users: 4328,
      revenue: 12990,
      orders: 412,
      conversion: "2.5%"
    },
    visitors: {
      labels: Array.from({ length: 30 }, (_, i) => `Day ${i + 1}`),
      series: Array.from({ length: 30 }, () => Math.floor(200 + Math.random() * 800))
    },
    salesByCategory: {
      labels: ["Electronics", "Apparel", "Home", "Other"],
      series: [4200, 2600, 1800, 1390]
    },
    recent: [
      { user: "Alice", action: "Purchased Pro Plan", time: "10m ago" },
      { user: "Bob", action: "Signed up", time: "36m ago" },
      { user: "Clara", action: "Added item to cart", time: "1h ago" },
      { user: "David", action: "Completed checkout", time: "3h ago" }
    ]
  };

  let data = defaultData;

  // Try to fetch external data (optional)
  try {
    const resp = await fetch("data/mock-data.json", { cache: "no-store" });
    if (resp.ok) {
      data = await resp.json();
    } else {
      console.debug("No external data found, using default mock data.");
    }
  } catch (err) {
    console.debug("Fetch failed (likely opened via file://); using inline mock data.", err);
  }

  // Populate stat cards
  document.getElementById("stat-users").textContent = data.stats.users.toLocaleString();
  document.getElementById("stat-revenue").textContent = "$" + data.stats.revenue.toLocaleString();
  document.getElementById("stat-orders").textContent = data.stats.orders.toLocaleString();
  document.getElementById("stat-conversion").textContent = data.stats.conversion;

  // Recent activity table
  const recentBody = document.getElementById("recent-activity");
  recentBody.innerHTML = data.recent
    .map(
      (r) => `<tr class="hover:bg-gray-50">
        <td class="py-3">${r.user}</td>
        <td class="py-3 text-gray-600">${r.action}</td>
        <td class="py-3 text-gray-500">${r.time}</td>
      </tr>`
    )
    .join("");

  // Charts (Chart.js needs canvas elements present)
  // Traffic line chart
  const tCtx = document.getElementById("chart-traffic").getContext("2d");
  new Chart(tCtx, {
    type: "line",
    data: {
      labels: data.visitors.labels,
      datasets: [
        {
          label: "Visitors",
          data: data.visitors.series,
          borderColor: "#4f46e5",
          backgroundColor: "rgba(79,70,229,0.08)",
          tension: 0.3,
          pointRadius: 0,
          fill: true
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { mode: "index", intersect: false }
      },
      scales: {
        x: { display: false },
        y: { ticks: { beginAtZero: true } }
      }
    }
  });

  // Sales by category bar chart
  const sCtx = document.getElementById("chart-sales").getContext("2d");
  new Chart(sCtx, {
    type: "bar",
    data: {
      labels: data.salesByCategory.labels,
      datasets: [
        {
          label: "Sales",
          data: data.salesByCategory.series,
          backgroundColor: ["#6366f1", "#8b5cf6", "#06b6d4", "#f97316"]
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {}
      },
      scales: {
        x: { ticks: { color: "#6b7280" } },
        y: { beginAtZero: true }
      }
    }
  });

  // Sidebar toggle for mobile
  const sidebar = document.getElementById("sidebar");
  const btnToggle = document.getElementById("btnToggle");
  btnToggle.addEventListener("click", () => {
    if (!sidebar) return;
    sidebar.classList.toggle("hidden");
  });
})();
